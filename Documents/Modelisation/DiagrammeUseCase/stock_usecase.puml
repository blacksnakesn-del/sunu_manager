@startuml stock use case


left to right direction
skinparam packageStyle rectangle

actor "Chargé de Stock" as Stock

rectangle "Sunu Manager" {

    usecase "Gérer Approvisionnements" as UC4
    usecase "Gérer Catalogue\n(Produits / Clients / Fournisseurs)" as UC5

    usecase "Réceptionner Lot / Bon de Livraison" as UC_Livraison
    usecase "Mettre à jour les Stocks" as UC_Stock

    Stock --> UC4
    Stock --> UC5

    UC4 .> UC_Livraison : <<include>>
    UC4 .> UC_Stock : <<include>>
}


@enduml